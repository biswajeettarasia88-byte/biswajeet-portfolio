# ==============================================================================
# Portfolio Environment Variables Configuration
# ==============================================================================
# Client-side variables (prefixed with VITE_) are accessible in the React bundle.
# NEVER store private API keys, SMTP credentials, or secret tokens here.

# Optional: External Contact Form API Endpoint URL.
# If you deploy the serverless function (api/contact.js) on Vercel, Cloudflare, or AWS,
# set this URL (e.g., https://your-portfolio-api.vercel.app/api/contact).
# If left blank, the portfolio automatically routes directly via FormSubmit AJAX gateway
# to biswajeettarasia88@gmail.com without requiring a custom serverless deployment.
VITE_CONTACT_API_URL=

# ==============================================================================
# Serverless Backend Environment Variables
# (Configure ONLY in your hosting dashboard: Vercel, Cloudflare, Netlify, or Railway)
# NEVER commit real values to Git or place in client-side .env files.
# ==============================================================================
# RESEND_API_KEY=re_1234567890abcdef
# CONTACT_RECIPIENT_EMAIL=biswajeettarasia88@gmail.com
# CONTACT_VERIFIED_SENDER=portfolio@yourdomain.com
